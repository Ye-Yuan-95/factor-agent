{
  "input_csv": "data/a_share_factor_panel.csv",
  "output_dir": "outputs/a_share_baseline",
  "date_col": "date",
  "asset_col": "asset",
  "target_col": "forward_return",
  "factor_cols": [
    "mom1m",
    "mom6m",
    "mom12m",
    "mom_12_1",
    "mom36m",
    "volatility",
    "retvol",
    "beta",
    "idiovol",
    "dolvol",
    "volume_proxy",
    "turn",
    "size",
    "currat",
    "quick",
    "roeq",
    "agr",
    "mom3m",
    "mom9m",
    "maxret",
    "minret",
    "retvol6m",
    "retskew",
    "retkurt",
    "downvol",
    "high52w",
    "illiq",
    "mom24m",
    "std_dolvol",
    "std_turn",
    "roa",
    "gma",
    "grossmargin",
    "operprof",
    "assetturn",
    "lev",
    "cashdebt",
    "acc",
    "chinv",
    "ocf2assets",
    "bm",
    "ep",
    "sp",
    "cfp"
  ],
  "family_constraints": {
    "factor_families": {
      "mom24m": "momentum",
      "std_dolvol": "liquidity",
      "std_turn": "liquidity",
      "roa": "profitability",
      "gma": "profitability",
      "grossmargin": "profitability",
      "operprof": "profitability",
      "assetturn": "profitability",
      "ocf2assets": "profitability",
      "lev": "leverage",
      "cashdebt": "leverage",
      "acc": "accruals",
      "chinv": "investment",
      "bm": "value",
      "ep": "value",
      "sp": "value",
      "cfp": "value",
      "mom1m": "momentum",
      "mom6m": "momentum",
      "mom12m": "momentum",
      "mom_12_1": "momentum",
      "mom36m": "momentum",
      "mom3m": "momentum",
      "mom9m": "momentum",
      "high52w": "momentum",
      "volatility": "risk",
      "retvol": "risk",
      "beta": "risk",
      "idiovol": "risk",
      "retvol6m": "risk",
      "downvol": "risk",
      "maxret": "tail",
      "minret": "tail",
      "retskew": "tail",
      "retkurt": "tail",
      "dolvol": "liquidity",
      "volume_proxy": "liquidity",
      "turn": "liquidity",
      "illiq": "liquidity",
      "size": "size",
      "currat": "fundamental",
      "quick": "fundamental",
      "roeq": "fundamental",
      "agr": "fundamental"
    },
    "max_per_family": {
      "momentum": 2,
      "risk": 3,
      "tail": 2,
      "liquidity": 2,
      "value": 2,
      "profitability": 2
    }
  },
  "screening": {
    "min_coverage": 0.45,
    "q_value_max": 0.25,
    "min_abs_ic": 0.005,
    "min_long_short": 0.0,
    "long_short_quantile": 0.3,
    "hac_lags": 3
  },
  "redundancy": {
    "max_abs_corr": 0.85
  },
  "incremental": {
    "min_abs_tstat": 2.0
  },
  "optimization": {
    "l1_alpha": 0.00005,
    "l2_alpha": 0.001,
    "max_iter": 3000,
    "tol": 1e-8,
    "min_abs_weight": 0.000001
  },
  "synthetic": {
    "n_scenarios": 30,
    "mean_block_length": 12.0,
    "noise_std_fraction": 0.05,
    "random_seed": 42,
    "survival_metric": "long_short",
    "survival_threshold": 0.0,
    "directional_survival": true,
    "min_degradation_ratio": 0.5,
    "min_survival_rate": 0.6
  }
}
